# Vercel CLI only (not used by Astro runtime). Create at https://vercel.com/account/tokens
# VERCEL_TOKEN=

# Server-side API (SSR → api.yuhang.ch)
API_URL=https://api.yuhang.ch/v1
# Ed25519 PKCS8 PEM, one line with \n escapes. Generate: cd ../api.yuhang.ch && pnpm keys:generate
API_JWT_PRIVATE_KEY=
# Deprecated after JWT cutover (optional during transition)
# API_SECRET=

STUDIO_SECRET=replace-with-studio-basic-secret
AMAP_KEY=replace-with-amap-key

# Safe to expose to browser bundles
MAPBOX_TOKEN=replace-with-mapbox-public-token
